---
import hubspot from "../data/hubspot.json";
interface Props {
  lang?: "de" | "en";
}
const { lang = "de" } = Astro.props;
const isEn = lang === "en";
const configured =
  !String(hubspot.portalId).startsWith("REPLACE_") &&
  !String(hubspot.whitepaperFormId).startsWith("REPLACE_");
---
<div class="mli-hubspot-whitepaper border rounded p-4 bg-white">
  <h3 class="h4 mb-3">{isEn ? "Download whitepaper" : "Whitepaper herunterladen"}</h3>
  {
    configured ? (
      <div
        class="hs-form-frame"
        data-region={hubspot.region}
        data-form-id={hubspot.whitepaperFormId}
        data-portal-id={hubspot.portalId}
      />
    ) : (
      <p class="mb-0">
        {isEn
          ? "Configure portalId and whitepaperFormId in src/data/hubspot.json, then run npm run generate:pages."
          : "Bitte portalId und whitepaperFormId in src/data/hubspot.json setzen und npm run generate:pages ausführen."}
      </p>
    )
  }
</div>
<script is:inline charset="utf-8" type="text/javascript" src="https://js-eu1.hsforms.net/forms/embed/v2.js"></script>
